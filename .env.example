# AI Gateway Open — configuration d'exemple du profil Compact.
# Copier vers .env (ignoré par git) puis adapter. Référence complète :
# doc/03-configuration.md. Aucun secret n'est nécessaire au fonctionnement.

# --- Réseau Gateway ---------------------------------------------------------
AI_GATEWAY_PORT=8100
AI_GATEWAY_TIMEOUT_SECONDS=120
AI_GATEWAY_LOG_LEVEL=INFO
# Environnement logique confronté aux allowlists du registre (production|staging).
AI_GATEWAY_ENVIRONMENT=production

# --- Runtime de génération et d'embeddings : Ollama LOCAL -----------------
# Dans docker-compose.yml le service s'appelle `ollama` ; hors Docker : http://127.0.0.1:11434
OLLAMA_BASE_URL=http://ollama:11434
# Noms LOGIQUES du registre Compact (app/models_registry.yaml).
OLLAMA_GENERATE_MODEL=compact-generation
OLLAMA_EMBEDDING_MODEL=fr-en-retrieval
# Contrainte d'index Compact v1 : 768 dimensions.
AI_GATEWAY_EMBEDDINGS_DIMENSION=768
AI_GATEWAY_EMBEDDINGS_MAX_BATCH=64

# --- Registres STRICTS (défaut Open ; 0 = relais legacy, déconseillé) -------
AI_GATEWAY_GENERATION_STRICT_REGISTRY=1
AI_GATEWAY_EMBEDDINGS_STRICT_REGISTRY=1

# --- Limites explicites -----------------------------------------------------
AI_GATEWAY_GENERATE_MAX_CONCURRENCY=2
AI_GATEWAY_EMBEDDINGS_MAX_CONCURRENCY=2
AI_GATEWAY_REQUEST_MAX_BYTES=2097152

# --- Reranking : backend TEI LOCAL (boucle locale obligatoire) --------------
AI_GATEWAY_RERANK_ENABLED=1
AI_GATEWAY_RERANK_BACKEND_URL=http://127.0.0.1:8300
AI_GATEWAY_RERANK_MODEL=rerank-default
AI_GATEWAY_RERANK_TIMEOUT_SECONDS=15
AI_GATEWAY_RERANK_MAX_CONCURRENCY=2

# --- Capacités optionnelles : OFF par défaut (aucun backend inclus) ---------
AI_GATEWAY_ASR_ENABLED=0
AI_GATEWAY_VISION_ENABLED=0

# --- Sondes ----------------------------------------------------------------
AI_GATEWAY_READINESS_CACHE_SECONDS=60
AI_GATEWAY_READINESS_TIMEOUT_SECONDS=5
AI_GATEWAY_REGISTRY_VERIFY_INTERVAL_SECONDS=300

# --- Provenance de build : image du backend de reranking (TEI) -----------------
# Source UNIQUE du digest : lu par docker-compose.yml et docker-compose.reranker.yml
# (ligne image@digest, interpolé depuis .env) et exposé par la Gateway sur
# /health/runtime. Variante CPU de ghcr.io/huggingface/text-embeddings-inference.
AI_GATEWAY_RERANK_BACKEND_IMAGE_DIGEST=sha256:8de25e75ce39617f17f2f6c77d60a4f75b65e779ed5005420eb1400072a15c1c
